{{#if isRoomView}}
  <div class="page page_watch-party-room">
    <header id="header"></header>

    <main class="watch-room-page">
      {{#if loading}}
        <section class="watch-room-state">
          <h1 class="watch-room-state__title">Подключаем комнату</h1>
          <p class="watch-room-state__text">Получаем состояние совместного просмотра...</p>
        </section>
      {{else}}
        {{#if hasError}}
          <section class="watch-room-state watch-room-state_error">
            <h1 class="watch-room-state__title">{{errorTitle}}</h1>
            <p class="watch-room-state__text">{{errorText}}</p>
            <a class="watch-room-state__link" href="/watch-party" router-link>Вернуться в лобби</a>
          </section>
        {{else}}
          <section class="watch-room-shell">
            <div
              class="watch-room-shell__status watch-room-shell__status_{{roomStatusTone}}"
              data-role="watch-party-room-status"
              {{#unless roomStatusMessage}}hidden{{/unless}}
            >
              {{roomStatusMessage}}
            </div>

            <div
              class="watch-room-reactions"
              data-role="watch-party-reactions-layer"
              {{#if areRoomReactionsHidden}}hidden{{/if}}
              aria-hidden="true"
            ></div>

            <div class="watch-room-shell__layout">
              <div class="watch-room-shell__main">
                <section class="watch-room-player-slot">
                  {{#if hasRoomMovieSelection}}
                    <div id="watch-party-room-player"></div>
                  {{else}}
                    <section class="watch-room-selection">
                      <div class="watch-room-selection__header">
                        <div>
                          <div class="watch-room-selection__kicker">Комната создана</div>
                          <h2 class="watch-room-selection__title">Выберите фильм для этой комнаты</h2>
                        </div>

                        <div class="watch-room-selection__controls">
                          <button
                            class="watch-room-selection__arrow"
                            type="button"
                            data-action="scroll-room-movie-candidates-prev"
                            aria-label="Прокрутить влево"
                          >
                            <span>&lsaquo;</span>
                          </button>
                          <button
                            class="watch-room-selection__arrow"
                            type="button"
                            data-action="scroll-room-movie-candidates-next"
                            aria-label="Прокрутить вправо"
                          >
                            <span>&rsaquo;</span>
                          </button>
                        </div>
                      </div>

                      {{#if topMovieCandidatesLoading}}
                        <div class="watch-room-selection__state">Подбираем топ 10 для комнаты...</div>
                      {{else}}
                        {{#if topMovieCandidatesError}}
                          <div class="watch-room-selection__state watch-room-selection__state--error">
                            {{topMovieCandidatesError}}
                          </div>
                        {{/if}}

                        <div class="watch-room-selection__viewport" data-role="room-movie-candidates">
                          <div class="watch-room-selection__track">
                            {{#each topMovieCandidates}}
                              <article class="watch-room-selection__card">
                                <div class="watch-room-selection__rank">Топ {{this.rank}}</div>
                                <img
                                  class="watch-room-selection__thumb"
                                  src="{{this.imageUrl}}"
                                  alt="{{this.title}}"
                                />
                                <div class="watch-room-selection__body">
                                  <div class="watch-room-selection__movie">{{this.title}}</div>
                                  {{#if this.subtitle}}
                                    <div class="watch-room-selection__meta">{{this.subtitle}}</div>
                                  {{/if}}
                                </div>
                                <button
                                  class="watch-room-selection__choose"
                                  type="button"
                                  data-action="select-top-room-movie"
                                  data-movie-id="{{this.id}}"
                                >
                                  Выбрать
                                </button>
                              </article>
                            {{/each}}
                          </div>
                        </div>
                      {{/if}}
                    </section>
                  {{/if}}
                </section>

                <div class="watch-room-topbar">
                  <div class="watch-room-topbar__start">

                    <div class="watch-room-topbar__meta">
                      <div class="watch-room-topbar__headline">
                        <div class="watch-room-topbar__room">{{roomName}}</div>

                        {{#if liveLabel}}
                          <div class="watch-room-topbar__live">{{liveLabel}}</div>
                        {{/if}}
                      </div>

                      <div class="watch-room-topbar__details">
                        <span>{{movieTitle}}</span>
                        <span>{{privacyLabel}}</span>
                      </div>
                    </div>
                  </div>

                  <div class="watch-room-topbar__actions">
                    <button
                      class="watch-room-topbar__action"
                      type="button"
                      data-action="open-room-chat"
                    >
                      Чат
                    </button>
                    <button
                      class="watch-room-topbar__action watch-room-topbar__action_reactions{{#unless areRoomReactionsHidden}} is-active{{/unless}}"
                      type="button"
                      data-action="toggle-room-reactions"
                      aria-pressed="{{#unless areRoomReactionsHidden}}true{{else}}false{{/unless}}"
                    >
                      {{roomReactionsToggleLabel}}
                    </button>
                    <button
                      class="watch-room-topbar__action watch-room-topbar__action_feed"
                      type="button"
                      data-action="open-feed-monkey-modal"
                    >
                      Покормить обезьяну · 1 VKino coin
                    </button>
                    {{#if canInviteFriends}}
                      <button
                        class="watch-room-topbar__action watch-room-topbar__action_copy"
                        type="button"
                        data-action="open-room-invite-modal"
                      >
                        Пригласить
                      </button>
                    {{/if}}
                  </div>
                </div>
              </div>
            </div>

            <div
              class="watch-room-drawer__backdrop{{#if isRoomPanelOpen}} is-visible{{/if}}"
              data-action="close-room-panel"
            ></div>

            <aside class="watch-room-drawer{{#if isRoomPanelOpen}} is-open{{/if}}">
              <div class="watch-room-drawer__header">
                <div class="watch-room-drawer__tabs">
                  <button
                    class="watch-room-drawer__tab{{#if isMembersPanel}} is-active{{/if}}"
                    type="button"
                    data-action="open-room-members"
                  >
                    Участники
                  </button>
                  <button
                    class="watch-room-drawer__tab{{#if isChatPanel}} is-active{{/if}}"
                    type="button"
                    data-action="open-room-chat"
                  >
                    Чат
                  </button>
                </div>

                <button
                  class="watch-room-drawer__close"
                  type="button"
                  data-action="close-room-panel"
                  aria-label="Закрыть панель"
                >
                  <span></span>
                  <span></span>
                </button>
              </div>

              <section
                class="watch-room-members watch-room-drawer__panel{{#if isMembersPanel}} is-active{{/if}}"
                {{#unless isMembersPanel}}hidden{{/unless}}
              >
                  <div class="watch-room-members__header">
                    <div class="watch-room-members__bar"></div>
                    <div class="watch-room-members__title">Участники</div>
                    <div class="watch-room-members__count">{{roomMembersCount}}</div>
                  </div>

                  <div class="watch-room-members__list">
                    {{#each members}}
                      <div class="watch-room-members__item">
                        <div
                          class="watch-room-members__avatar"
                          style="--watch-party-avatar-tint: {{this.avatarTint}}; --watch-party-status-color: {{this.statusColor}}"
                        >
                          {{this.initial}}
                          <div class="watch-room-members__status-dot"></div>
                        </div>

                        <div class="watch-room-members__identity">
                          <div class="watch-room-members__name{{#if this.statusText}} is-away{{/if}}">
                            {{this.name}}
                          </div>

                          <div class="watch-room-members__meta">
                            {{#if this.isHost}}
                              <span class="watch-room-members__host">хозяин</span>
                            {{/if}}
                            {{#if this.isYou}}
                              <span class="watch-room-members__you">вы</span>
                            {{/if}}
                            {{#if this.statusText}}
                              <span class="watch-room-members__state">{{this.statusText}}</span>
                            {{/if}}
                          </div>
                        </div>
                      </div>
                    {{/each}}
                  </div>
              </section>

              <section
                class="watch-room-chat watch-room-drawer__panel{{#if isChatPanel}} is-active{{/if}}"
                id="watch-party-room-chat"
                {{#unless isChatPanel}}hidden{{/unless}}
              ></section>
            </aside>

            {{#if isFeedMonkeyModalOpen}}
              <div class="watch-room-feed">
                <button
                  class="watch-room-feed__backdrop"
                  type="button"
                  data-action="close-feed-monkey-modal"
                  aria-label="Закрыть окно кормления"
                ></button>

                <section
                  class="watch-room-feed__dialog"
                  role="dialog"
                  aria-modal="true"
                  aria-labelledby="watch-room-feed-title"
                >
                  <div class="watch-room-feed__header">
                    <h2 class="watch-room-feed__title" id="watch-room-feed-title">
                      Покормить обезьяну · 1 VKino coin
                    </h2>
                    <button
                      class="watch-room-feed__close"
                      type="button"
                      data-action="close-feed-monkey-modal"
                      aria-label="Закрыть окно кормления"
                    >
                      <span></span>
                      <span></span>
                    </button>
                  </div>

                  <div
                    class="monkey-widget"
                    data-role="feed-monkey-widget"
                  >
                    <div class="monkey-stage">
                      <div class="banana" aria-hidden="true">
                        <svg viewBox="0 0 60 80" xmlns="http://www.w3.org/2000/svg">
                          <defs>
                            <linearGradient id="watch-room-banana-grad" x1="0" y1="0" x2="1" y2="1">
                              <stop offset="0%" stop-color="#fde047" />
                              <stop offset="60%" stop-color="#facc15" />
                              <stop offset="100%" stop-color="#ca8a04" />
                            </linearGradient>
                          </defs>
                          <path
                            d="M 15 8 Q 8 35 18 60 Q 28 75 48 70 Q 52 68 50 64 Q 35 68 28 55 Q 20 38 25 18 Q 26 12 22 9 Q 18 7 15 8 Z"
                            fill="url(#watch-room-banana-grad)"
                            stroke="#854d0e"
                            stroke-width="1.5"
                            stroke-linejoin="round"
                          />
                          <path
                            d="M 15 8 Q 14 4 18 3 Q 22 4 22 9"
                            fill="#365314"
                            stroke="#1a2e05"
                            stroke-width="1"
                          />
                          <path
                            d="M 20 18 Q 16 35 22 55"
                            stroke="rgba(255,255,255,0.45)"
                            stroke-width="2"
                            fill="none"
                            stroke-linecap="round"
                          />
                        </svg>
                      </div>

                      <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" aria-label="Обезьянка">
                        <defs>
                          <radialGradient id="watch-room-fur-grad" cx="0.4" cy="0.35" r="0.7">
                            <stop offset="0%" stop-color="#a16d3f" />
                            <stop offset="100%" stop-color="#6b4423" />
                          </radialGradient>
                          <radialGradient id="watch-room-belly-grad" cx="0.5" cy="0.4" r="0.6">
                            <stop offset="0%" stop-color="#f5d4a8" />
                            <stop offset="100%" stop-color="#d4a574" />
                          </radialGradient>
                          <radialGradient id="watch-room-face-grad" cx="0.5" cy="0.55" r="0.55">
                            <stop offset="0%" stop-color="#f5d4a8" />
                            <stop offset="100%" stop-color="#c8956d" />
                          </radialGradient>
                        </defs>

                        <g class="monkey-body">
                          <path
                            d="M 145 160 Q 175 155 178 130 Q 180 110 165 108"
                            stroke="#6b4423"
                            stroke-width="9"
                            fill="none"
                            stroke-linecap="round"
                          />
                          <path
                            d="M 145 160 Q 175 155 178 130 Q 180 110 165 108"
                            stroke="#8b5a2b"
                            stroke-width="5"
                            fill="none"
                            stroke-linecap="round"
                          />

                          <ellipse cx="82" cy="178" rx="14" ry="10" fill="#6b4423" />
                          <ellipse cx="118" cy="178" rx="14" ry="10" fill="#6b4423" />
                          <ellipse cx="82" cy="178" rx="9" ry="6" fill="#d4a574" />
                          <ellipse cx="118" cy="178" rx="9" ry="6" fill="#d4a574" />

                          <ellipse cx="100" cy="150" rx="38" ry="32" fill="url(#watch-room-fur-grad)" />
                          <ellipse cx="100" cy="155" rx="22" ry="20" fill="url(#watch-room-belly-grad)" />

                          <g class="arm-left">
                            <path
                              d="M 70 135 Q 55 150 58 168"
                              stroke="#6b4423"
                              stroke-width="14"
                              fill="none"
                              stroke-linecap="round"
                            />
                            <circle cx="58" cy="170" r="9" fill="#8b5a2b" />
                            <circle cx="58" cy="170" r="6" fill="#d4a574" />
                          </g>
                          <g class="arm-right">
                            <path
                              d="M 130 135 Q 145 150 142 168"
                              stroke="#6b4423"
                              stroke-width="14"
                              fill="none"
                              stroke-linecap="round"
                            />
                            <circle cx="142" cy="170" r="9" fill="#8b5a2b" />
                            <circle cx="142" cy="170" r="6" fill="#d4a574" />
                          </g>

                          <g class="monkey-head">
                            <circle cx="62" cy="85" r="14" fill="#6b4423" />
                            <circle cx="138" cy="85" r="14" fill="#6b4423" />
                            <circle cx="62" cy="85" r="8" fill="#d4a574" />
                            <circle cx="138" cy="85" r="8" fill="#d4a574" />

                            <circle cx="100" cy="85" r="42" fill="url(#watch-room-fur-grad)" />
                            <ellipse cx="100" cy="98" rx="30" ry="28" fill="url(#watch-room-face-grad)" />
                            <path
                              d="M 65 70 Q 80 58 100 60 Q 120 58 135 70 Q 125 75 100 73 Q 75 75 65 70 Z"
                              fill="#5d3a1f"
                            />

                            <circle class="monkey-cheek" cx="80" cy="105" r="6" fill="#ec7c7c" opacity="0" />
                            <circle class="monkey-cheek" cx="120" cy="105" r="6" fill="#ec7c7c" opacity="0" />

                            <g class="monkey-eye">
                              <ellipse cx="88" cy="90" rx="4.5" ry="5.5" fill="#2a1810" />
                              <ellipse cx="112" cy="90" rx="4.5" ry="5.5" fill="#2a1810" />
                              <circle cx="89" cy="88" r="1.5" fill="#fff" />
                              <circle cx="113" cy="88" r="1.5" fill="#fff" />
                            </g>

                            <ellipse cx="100" cy="100" rx="2.5" ry="1.8" fill="#5d3a1f" />
                            <path
                              class="monkey-mouth"
                              d="M 92 108 Q 100 114 108 108"
                              stroke="#5d3a1f"
                              stroke-width="2"
                              fill="#8b3a1f"
                              stroke-linecap="round"
                            />
                          </g>
                        </g>
                      </svg>
                    </div>
                  </div>

                  <div class="watch-room-feed__actions">
                    <button
                      class="feed-btn"
                      type="button"
                      data-action="feed-monkey"
                    >
                      Покормить ещё · 1 VKino coin
                    </button>
                  </div>
                </section>
              </div>
            {{/if}}

            {{#if canInviteFriends}}
              {{#if isInviteModalOpen}}
              <div class="watch-room-invite">
                <button
                  class="watch-room-invite__backdrop"
                  type="button"
                  aria-hidden="true"
                  tabindex="-1"
                ></button>

                <section
                  class="watch-room-invite__dialog"
                  role="dialog"
                  aria-modal="true"
                  aria-labelledby="watch-room-invite-title"
                >
                  <div class="watch-room-invite__header">
                    <div class="watch-room-invite__copy">
                      <div class="watch-room-invite__eyebrow">Приглашение в комнату</div>
                      <h2 class="watch-room-invite__title" id="watch-room-invite-title">
                        Позовите друзей в просмотр
                      </h2>
                      <p class="watch-room-invite__subtitle">
                        Отправьте приглашение друзьям или скопируйте ссылку на комнату.
                      </p>
                    </div>

                    <button
                      class="watch-room-invite__close"
                      type="button"
                      data-action="close-room-invite-modal"
                      aria-label="Закрыть окно приглашения"
                    >
                      <span></span>
                      <span></span>
                    </button>
                  </div>

                  <div class="watch-room-invite__share">
                    <div class="watch-room-invite__link">
                      <span class="watch-room-invite__link-label">Ссылка для комнаты</span>
                      <span class="watch-room-invite__link-value">{{inviteLink}}</span>
                    </div>

                    <button
                      class="watch-room-invite__copy-button"
                      type="button"
                      data-action="copy-room-link"
                      data-link="{{inviteLink}}"
                    >
                      Скопировать ссылку
                    </button>
                  </div>

                  <div class="watch-room-invite__friends">
                    <div class="watch-room-invite__friends-head">
                      <span>Друзья</span>
                      <span>{{inviteFriends.length}}</span>
                    </div>

                    {{#if inviteFriendsLoading}}
                      <div class="watch-room-invite__state">Загружаем список друзей...</div>
                    {{else}}
                      {{#if inviteFriendsError}}
                        <div class="watch-room-invite__state watch-room-invite__state_error">
                          {{inviteFriendsError}}
                        </div>
                      {{else}}
                        {{#if inviteFriends.length}}
                          <div class="watch-room-invite__list">
                            {{#each inviteFriends}}
                              <div class="watch-room-invite__item">
                                <div class="watch-room-invite__friend">
                                  <div class="watch-room-invite__avatar">
                                    <img src="{{this.avatarUrl}}" alt="{{this.displayName}}" />
                                  </div>

                                  <div class="watch-room-invite__friend-copy">
                                    <div class="watch-room-invite__friend-name">{{this.displayName}}</div>
                                    <div class="watch-room-invite__friend-email">{{this.email}}</div>
                                  </div>
                                </div>

                                <div class="watch-room-invite__item-actions">
                                  {{#if this.statusLabel}}
                                    <span class="watch-room-invite__badge">{{this.statusLabel}}</span>
                                  {{/if}}

                                  <button
                                    class="watch-room-invite__friend-button"
                                    type="button"
                                    data-action="invite-room-friend"
                                    data-friend-id="{{this.id}}"
                                    {{#if this.isInviteDisabled}}disabled{{/if}}
                                  >
                                    {{this.inviteButtonLabel}}
                                  </button>
                                </div>
                              </div>
                            {{/each}}
                          </div>
                        {{else}}
                          <div class="watch-room-invite__state">
                            У вас пока нет друзей для приглашения.
                          </div>
                        {{/if}}
                      {{/if}}
                    {{/if}}
                  </div>
                </section>
              </div>
              {{/if}}
            {{/if}}
          </section>
        {{/if}}
      {{/if}}
    </main>
  </div>
{{else}}
  <div class="page page_watch-party">
    <header id="header"></header>

    <main class="watch-party-page">
      <div class="watch-party-page__inner">
        {{#if isLoading}}
          <div class="watch-party__status" role="status">
            Загружаем данные комнаты...
          </div>
        {{/if}}

        {{#if errorMessage}}
          <div class="watch-party__status watch-party__status--error" role="alert">
            <span>{{errorMessage}}</span>
            <button
              class="watch-party__button watch-party__button--ghost"
              type="button"
              data-action="retry-overview"
            >
              Повторить
            </button>
          </div>
        {{/if}}

        {{#if statusMessage}}
          <div
            class="watch-party__status watch-party__status--{{statusTone}}"
            role="status"
          >
            {{statusMessage}}
          </div>
        {{/if}}

        <section class="watch-party__hero">
          <div class="watch-party__hero-copy">
            <div class="watch-party__eyebrow">{{heroEyebrow}}</div>
            <h1 class="watch-party__title">{{heroTitle}}</h1>
            <p class="watch-party__subtitle">{{heroSubtitle}}</p>
            <p class="watch-party__description">{{heroDescription}}</p>

            <div class="watch-party__hero-actions">
              <button
                class="watch-party__button watch-party__button--accent"
                type="button"
                data-action="scroll-to-section"
                data-target="create-room-section"
              >
                Создать комнату
              </button>
              <button
                class="watch-party__button watch-party__button--ghost"
                type="button"
                data-action="scroll-to-section"
                data-target="join-room-section"
              >
                Войти по ссылке
              </button>
            </div>
          </div>

          <div class="watch-party__poster-stack" aria-label="Подборка для совместного просмотра">
            {{#each heroPostersDisplay}}
              {{#if this.isHeroCreateRoomPlaceholder}}
                <button
                  class="watch-party__poster-card watch-party__poster-card--create"
                  type="button"
                  data-action="scroll-to-section"
                  data-target="create-room-section"
                >
                  <span class="watch-party__poster-card-create__inner">
                    <span class="watch-party__poster-card-create__icon" aria-hidden="true">+</span>
                    <span class="watch-party__poster-card-create__content">
                      <span class="watch-party__poster-card-create__title">Создать комнату</span>
                      <span class="watch-party__poster-card-create__text">
                        Быстрый переход к настройке новой комнаты
                      </span>
                    </span>
                  </span>
                </button>
              {{else}}
                <article class="watch-party__poster-card">
                  <img src="{{this.imageUrl}}" alt="{{this.title}}" />
                  <div class="watch-party__poster-overlay">
                    <span class="watch-party__poster-chip">{{this.label}}</span>
                    <button
                      class="watch-party__poster-cta"
                      type="button"
                      {{#if this.roomHref}}
                        data-action="join-featured-room"
                        data-room-link="{{this.roomHref}}"
                      {{else}}
                        disabled
                      {{/if}}
                    >
                      Присоединиться
                    </button>
                  </div>
                </article>
              {{/if}}
            {{/each}}
          </div>
        </section>

        <section class="watch-party__section" id="create-room-section">
          <div class="watch-party__section-heading">
            <div>
              <p class="watch-party__section-kicker">Быстрый старт</p>
              <h2 class="watch-party__section-title">Настройте комнату под свой сеанс</h2>
            </div>
          </div>

          <div class="watch-party__actions-grid">
            <article class="watch-party__action-card watch-party__action-card--accent">
              <div class="watch-party__action-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <circle cx="12" cy="12" r="9"></circle>
                  <path d="M12 8v8M8 12h8"></path>
                </svg>
              </div>
              <h3>Создать комнату</h3>
              <p>
                Укажите название, выберите режим доступа и сразу переходите
                в комнату по адресу вида <strong>/watch-party/id...</strong>.
              </p>

              <form class="watch-party__form" data-action="create-room">
                <label class="watch-party__field">
                  <span>Название комнаты</span>
                  <input
                    class="watch-party__input"
                    name="roomName"
                    type="text"
                    value="{{roomNameDraft}}"
                    placeholder="Например, Пятничный кинопросмотр"
                  />
                </label>

                <label class="watch-party__field">
                  <span>Доступ</span>
                  <div class="watch-party__category{{#if isVisibilityMenuOpen}} is-open{{/if}}" data-role="watch-party-visibility">
                    <input name="visibility" type="hidden" value="{{visibilitySelectedValue}}" />
                    <button
                      class="watch-party__input watch-party__category-trigger"
                      type="button"
                      aria-expanded="{{#if isVisibilityMenuOpen}}true{{else}}false{{/if}}"
                      aria-controls="watch-party-visibility-menu"
                      data-action="toggle-room-visibility-menu"
                    >
                      <span class="watch-party__category-trigger-label">{{visibilitySelectedLabel}}</span>
                    </button>
                    <div
                      class="watch-party__category-menu"
                      id="watch-party-visibility-menu"
                      {{#unless isVisibilityMenuOpen}}hidden{{/unless}}
                    >
                      {{#each visibilityOptions}}
                        <button
                          class="watch-party__category-option"
                          type="button"
                          data-action="select-room-visibility"
                          data-value="{{this.value}}"
                          data-label="{{this.label}}"
                        >
                          {{this.label}}
                        </button>
                      {{/each}}
                    </div>
                  </div>
                </label>

                <button
                  class="watch-party__button watch-party__button--accent watch-party__button--full"
                  type="submit"
                >
                  Создать комнату
                </button>
              </form>
            </article>

            <article
              class="watch-party__action-card watch-party__action-card--muted"
              id="join-room-section"
            >
              <div class="watch-party__action-icon watch-party__action-icon--muted" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M10 7H6a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h4"></path>
                  <path d="M13 8l5 4-5 4"></path>
                  <path d="M18 12h-9"></path>
                </svg>
              </div>
              <h3>Войти по ссылке</h3>
              <p>
                Если друг уже создал комнату, вставьте приглашение и переходите
                прямо в нужный URL.
              </p>

              <form class="watch-party__join-form" data-action="join-room">
                <label class="watch-party__field watch-party__field--grow">
                  <span>Ссылка-приглашение</span>
                  <input
                    class="watch-party__input"
                    name="inviteLink"
                    type="text"
                    value="{{inviteLinkDraft}}"
                    placeholder="https://vkino.tech/watch-party/join/<invite-code>"
                  />
                </label>
                <button class="watch-party__button watch-party__button--ghost" type="submit">
                  Войти
                </button>
              </form>
            </article>
          </div>
        </section>

        <section class="watch-party__section">
          <div class="watch-party__section-heading">
            <div>
              <p class="watch-party__section-kicker">Сейчас онлайн</p>
              <h2 class="watch-party__section-title">Активные комнаты</h2>
            </div>
            {{#if featuredRooms.length}}
              <span class="watch-party__badge">{{featuredRoomsOnlineLabel}}</span>
            {{/if}}
          </div>

          {{#if featuredRooms.length}}
            <div class="watch-party__room-grid">
              {{#each featuredRooms}}
                <article class="watch-party__room-card">
                  <div class="watch-party__room-media">
                    <img src="{{this.imageUrl}}" alt="{{this.title}}" />

                    <div class="watch-party__room-tags">
                      {{#if this.isLive}}
                        <span class="watch-party__room-tag watch-party__room-tag--live">LIVE</span>
                      {{/if}}
                      <span class="watch-party__room-tag watch-party__room-tag--secondary">
                        {{this.membersLabel}}
                      </span>
                    </div>
                  </div>

                  <div class="watch-party__room-body">
                    <h3>{{this.title}}</h3>
                    <p class="watch-party__room-host">
                      Хозяин: <span>{{this.hostName}}</span>
                    </p>
                    <p class="watch-party__room-host">{{this.movieTitle}} · {{this.progressLabel}}</p>

                    <div class="watch-party__room-actions">
                      {{#if this.roomHref}}
                        <button
                          class="watch-party__button watch-party__button--accent"
                          type="button"
                          data-action="join-featured-room"
                          data-room-link="{{this.roomHref}}"
                        >
                          Присоединиться
                        </button>
                        <button
                          class="watch-party__button watch-party__button--ghost"
                          type="button"
                          data-action="copy-link"
                          data-link="{{this.roomHref}}"
                        >
                          Сссылка
                        </button>
                      {{else}}
                        <button
                          class="watch-party__button watch-party__button--ghost"
                          type="button"
                          disabled
                        >
                          Нужна ссылка
                        </button>
                      {{/if}}
                    </div>
                  </div>
                </article>
              {{/each}}
            </div>
          {{else}}
            <div class="watch-party__empty-state">
              <h3>Нет комнат</h3>
              <p>{{featuredRoomsUnavailableText}}</p>
            </div>
          {{/if}}
        </section>

        <section class="watch-party__section">
          <div class="watch-party__section-heading">
            <div>
              <p class="watch-party__section-kicker">Под рукой</p>
              <h2 class="watch-party__section-title">Мои комнаты</h2>
            </div>
            <span class="watch-party__badge">{{myRoomsCountLabel}}</span>
          </div>

          {{#if myRooms.length}}
            <div class="watch-party__my-rooms">
              {{#each myRooms}}
                <article class="watch-party__my-room-card">
                  <img
                    class="watch-party__my-room-thumb"
                    src="{{this.imageUrl}}"
                    alt="{{this.title}}"
                  />

                  <div class="watch-party__my-room-content">
                    {{#if this.showStatusBadge}}
                      <span
                        class="watch-party__state-badge watch-party__state-badge--{{this.statusTone}}"
                      >
                        {{this.statusLabel}}
                      </span>
                    {{/if}}
                    <h3>{{this.title}}</h3>
                    <p>{{this.meta}}</p>

                    <div class="watch-party__room-actions">
                      <button
                        class="watch-party__button watch-party__button--accent"
                        type="button"
                        data-action="open-my-room"
                        data-room-id="{{this.id}}"
                      >
                        Войти
                      </button>
                      {{#if this.roomLink}}
                        <button
                          class="watch-party__button watch-party__button--ghost"
                          type="button"
                          data-action="copy-link"
                          data-link="{{this.roomLink}}"
                        >
                          Поделиться
                        </button>
                      {{/if}}
                      <button
                        class="watch-party__button watch-party__button--ghost watch-party__button--danger"
                        type="button"
                        data-action="delete-room"
                        data-room-id="{{this.id}}"
                        data-room-title="{{this.title}}"
                      >
                        Удалить
                      </button>
                    </div>
                  </div>
                </article>
              {{/each}}
            </div>
          {{else}}
            <div class="watch-party__empty-state">
              <h3>Нет комнат</h3>
              <p>Список комнат пуст.</p>
            </div>
          {{/if}}
        </section>
      </div>
    </main>
  </div>
{{/if}}
