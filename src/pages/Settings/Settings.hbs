<div class="page page_settings">
  <header id="header"></header>

  <main class="main-content main-content_settings">
    <div class="settings-layout">
      <div class="settings-main">
        <div class="settings__section">
          <h2 class="settings__title">Общие данные</h2>
          <div class="settings__avatar-block">
            <div class="settings__avatar-preview-wrap">
              <img
                class="settings__avatar-preview"
                src="{{userData.avatarUrl}}"
                alt="Аватар пользователя"
                data-role="avatar-preview"
              />
            </div>
            <div class="settings__avatar-controls">
              <label class="settings__btn settings__btn-avatar btn btn_outline" for="avatarInput">
                Выбрать фото
              </label>
              <input
                id="avatarInput"
                class="settings__avatar-input"
                type="file"
                accept="image/png,image/jpeg,image/webp"
              />
              <div class="settings__avatar-hint">PNG/JPG/WEBP, до 5MB</div>
              <div class="settings__error" id="avatar-error"></div>
            </div>
          </div>

          <div class="settings__form-grid">
            <div class="settings__field">
              <label class="settings__label">Email</label>
              <input class="settings__input" type="email" id="email" value="{{userData.email}}" readonly />
            </div>
            <div class="settings__field">
              <label class="settings__label">Дата рождения</label>
              <div class="settings-date" data-role="birthdate-picker">
                <input class="settings-date__value-input settings__input_editable" type="hidden" id="birthDate" value="{{userData.birthDate}}" data-field="birthdate" />
                <button
                  class="settings-date__trigger"
                  type="button"
                  data-action="toggle-birthdate-calendar"
                  data-role="birthdate-trigger"
                  aria-expanded="false"
                  aria-controls="birthdate-calendar"
                >
                  <span class="settings-date__value" data-role="birthdate-label">{{userData.birthDate}}</span>
                  <svg class="settings-date__icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="4" y="5.5" width="16" height="15" rx="2.5" stroke="currentColor" stroke-width="1.8"/>
                    <path d="M8 3.5V7.5M16 3.5V7.5M4.5 10H19.5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
                <div class="settings-date__popup" id="birthdate-calendar" data-role="birthdate-calendar" hidden>
                  <div class="settings-date__header">
                    <button class="settings-date__nav" type="button" data-action="birthdate-prev-month" aria-label="Предыдущий месяц">
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M15 18L9 12L15 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                    <div class="settings-date__selectors">
                      <select class="settings-date__select" data-role="birthdate-month" aria-label="Месяц"></select>
                      <select class="settings-date__select" data-role="birthdate-year" aria-label="Год"></select>
                    </div>
                    <button class="settings-date__nav" type="button" data-action="birthdate-next-month" aria-label="Следующий месяц">
                      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                        <path d="M9 18L15 12L9 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    </button>
                  </div>
                  <div class="settings-date__weekdays" aria-hidden="true">
                    <span>Пн</span>
                    <span>Вт</span>
                    <span>Ср</span>
                    <span>Чт</span>
                    <span>Пт</span>
                    <span>Сб</span>
                    <span>Вс</span>
                  </div>
                  <div class="settings-date__grid" data-role="birthdate-calendar-grid"></div>
                  <button class="settings-date__clear" type="button" data-action="clear-birthdate">Очистить</button>
                </div>
              </div>
            </div>
          </div>
          <div class="settings__error" id="birthdate-error"></div>
          <button class="settings__btn settings__btn_save btn btn_outline" data-action="save-profile" disabled>Сохранить</button>
          <div class="settings__error" id="profile-save-error"></div>
        </div>

        <div class="settings__section">
          <h2 class="settings__title">Сменить пароль</h2>
          <div class="settings__form-grid settings__form-grid_password">
            <div class="settings__field settings__field_password">
              <label class="settings__label">Старый пароль</label>
              <div class="settings__input-wrapper settings__input-wrapper_eye">
                <input class="settings__input settings__input_password_field" type="password" id="oldPassword" placeholder="Введите старый пароль" data-field="oldPassword" />
                <button class="settings__eye-btn eye-btn icon-button" type="button" aria-label="Показать пароль" data-target="oldPassword">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M2.5 12C4.4 8.6 7.7 6.2 12 6.2C16.3 6.2 19.6 8.6 21.5 12C19.6 15.4 16.3 17.8 12 17.8C7.7 17.8 4.4 15.4 2.5 12Z" stroke="currentColor" stroke-width="1.8"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
                    <path class="slash" d="M5 19L19 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
              <div class="settings__error" id="old-password-error"></div>
            </div>
            <div class="settings__field settings__field_password">
              <label class="settings__label">Новый пароль</label>
              <div class="settings__input-wrapper settings__input-wrapper_eye">
                <input class="settings__input settings__input_password_field" type="password" id="newPassword" placeholder="Пароль" data-field="newPassword" />
                <button class="settings__eye-btn eye-btn icon-button" type="button" aria-label="Показать пароль" data-target="newPassword">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M2.5 12C4.4 8.6 7.7 6.2 12 6.2C16.3 6.2 19.6 8.6 21.5 12C19.6 15.4 16.3 17.8 12 17.8C7.7 17.8 4.4 15.4 2.5 12Z" stroke="currentColor" stroke-width="1.8"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
                    <path class="slash" d="M5 19L19 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
              <div class="settings__error" id="new-password-error"></div>
            </div>
            <div class="settings__field settings__field_password">
              <label class="settings__label">Повторите пароль</label>
              <div class="settings__input-wrapper settings__input-wrapper_eye">
                <input class="settings__input settings__input_password_field" type="password" id="confirmPassword" placeholder="Повторите пароль" data-field="confirmPassword" />
                <button class="settings__eye-btn eye-btn icon-button" type="button" aria-label="Показать пароль" data-target="confirmPassword">
                  <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                    <path d="M2.5 12C4.4 8.6 7.7 6.2 12 6.2C16.3 6.2 19.6 8.6 21.5 12C19.6 15.4 16.3 17.8 12 17.8C7.7 17.8 4.4 15.4 2.5 12Z" stroke="currentColor" stroke-width="1.8"/>
                    <circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.8"/>
                    <path class="slash" d="M5 19L19 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  </svg>
                </button>
              </div>
              <div class="settings__error" id="confirm-password-error"></div>
            </div>
          </div>
          <button class="settings__btn settings__btn_change-password btn btn_outline" data-action="change-password">Изменить пароль</button>
          <div class="settings__success" id="password-success"></div>
        </div>

        <div class="settings__section settings__section_subscription" id="subscription">
          <h2 class="settings__title">Управление подписками</h2>

          {{#if currentSubscription}}
            <div class="subscription-current">
              <div class="subscription-current__header">
                <span class="subscription-current__tier subscription-tier--{{currentSubscription.tier}}">
                  {{currentSubscription.label}}
                </span>
                {{#if currentSubscription.renewsAt}}
                  <span class="subscription-current__renew">Активна до: {{currentSubscription.renewsAt}}</span>
                {{/if}}
              </div>
              <div class="subscription-current__actions">
                <a href="/subscription" class="btn btn_outline" router-link>Управление подпиской</a>
              </div>
              {{#if subscriptionUsageSummary}}
                <p class="subscription-current__usage">{{subscriptionUsageSummary}}</p>
              {{/if}}
            </div>
          {{else}}
            <div class="settings-subscription-empty">
              <p class="settings-subscription-empty__text">
                У вас нет подписки, но вы можете её приобрести и открыть больше возможностей VKino.
              </p>
              <a href="/subscription" class="btn btn_accent" router-link>Оформить подписку</a>
            </div>
          {{/if}}

          <div class="subscription-plans-preview">
            {{#each subscriptionPlans}}
              <div class="subscription-plan-preview {{#if this.isCurrent}}subscription-plan-preview_current{{/if}}">
                <div class="subscription-plan-preview__name">{{this.name}}</div>
                <div class="subscription-plan-preview__price">{{this.priceSummary}}</div>
                {{#if this.isCurrent}}
                  <span class="subscription-plan-preview__current">Текущий</span>
                {{else}}
                  <a href="/subscription#subscription-plans" class="subscription-plan-preview__link" router-link>Подробнее →</a>
                {{/if}}
              </div>
            {{/each}}
          </div>
        </div>
      </div>

      <div class="settings__coins-history">
        <div class="settings__coins-history-header">
          <h3 class="settings__coins-history-title">История VKino coins</h3>
          <button
            type="button"
            class="vk-coins-info"
            data-action="toggle-coins-info"
            aria-label="Что такое VKino coins"
            aria-expanded="false"
          >
            ?
          </button>
        </div>
        <div class="vk-coins-info-popover" hidden>{{coinsInfoText}}</div>
        <div class="settings__coins-history-scroll">
          <div class="settings__coins-history-list">
          {{#if coinHistory.length}}
            {{#each coinHistory}}
              <div class="settings__coins-history-item">
                <div class="settings__coins-history-item-top">
                  <time class="settings__coins-history-date">{{this.date}}</time>
                  <span class="settings__coins-history-amount-wrap">
                    <span class="settings__coins-history-amount settings__coins-history-amount_{{#if this.isPositive}}positive{{else}}negative{{/if}}">
                      {{this.amount}}
                    </span>
                    <img
                      class="settings__coins-history-coin-icon"
                      src="{{@root.coinsIconSrc}}"
                      alt=""
                      width="16"
                      height="16"
                      loading="lazy"
                      decoding="async"
                    />
                  </span>
                </div>
                <div class="settings__coins-history-meta">
                  <span class="settings__coins-history-direction settings__coins-history-direction_{{this.directionTone}}">
                    {{this.directionLabel}}
                  </span>
                  <span class="settings__coins-history-type">{{this.operationLabel}}</span>
                </div>
                {{#if this.description}}
                  <p class="settings__coins-history-description" title="{{this.description}}">{{this.description}}</p>
                {{/if}}
              </div>
            {{/each}}
          {{else}}
            <div class="settings__coins-history-empty">
              <p class="settings__coins-history-empty-title">{{emptyCoinsTitle}}</p>
              <p class="settings__coins-history-empty-description">{{emptyCoinsDescription}}</p>
            </div>
          {{/if}}
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
